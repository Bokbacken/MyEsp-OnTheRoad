dependencies:
  espressif/cjson:
    component_hash: e788323270d90738662d66fffa910bfe1fba019bba087f01557e70c40485b469
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.7.19~2
  espressif/esp_hosted:
    component_hash: 22b08509494d4465f0e2f91ee16973d76fe90d5a930fa3910b7a43615db001bf
    dependencies:
    - name: cherry-embedded/cherryusb
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32p4]
      - if: $CONFIG{ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST} == 1
      version: '>=1.6.0'
    - name: espressif/esp_tinyusb
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32s2, esp32s3, esp32s31]
      - if: $CONFIG{ESP_HOSTED_CP_TINYUSB_MANIFEST} == 1
      version: '*'
    - name: espressif/iot_usbh_rndis
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32p4]
      - if: $CONFIG{ESP_HOSTED_HOST_USB_RNDIS_MANIFEST} == 1
      version: ^0.5.2
    - name: espressif/usb_host_cdc_acm
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32p4]
      - if: $CONFIG{ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST} == 1
      version: '*'
    - name: idf
      require: private
      version: '>=5.5'
    source:
      registry_url: https://components.espressif.com/
      type: service
    targets:
    - esp32
    - esp32s2
    - esp32s3
    - esp32s31
    - esp32c2
    - esp32c3
    - esp32c5
    - esp32c6
    - esp32c61
    - esp32h2
    - esp32h4
    - esp32h21
    - esp32p4
    version: 3.1.0
  espressif/esp_websocket_client:
    component_hash: dc00233af846f3a744ada283a300e0d586040aadc3ee67361645ecdce4523672
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.8.0
  espressif/led_strip:
    component_hash: 027f68f2b57b0dca1d68dff6cc1139d9093825aa808c2bc3ca42bb2ce530fce9
    dependencies:
    - name: idf
      require: private
      version: '>=5.2'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 3.1.1
  espressif/mdns:
    component_hash: 2fa43caa78cc170842255bc7bf71f306bc815cae12e9496bfb12372423019ac7
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.15.1
  idf:
    source:
      type: idf
    version: 6.1.0
  lvgl/lvgl:
    component_hash: d5e723db3a3feca71e34e333a6598b7624e3822577d374e1d44f0e18374952e1
    dependencies:
    - name: espressif/freetype
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_FREETYPE} == True
      version: ^2.14.3
    - name: espressif/libjpeg-turbo
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBJPEG_TURBO} == True
      version: ^3.1.1
    - name: espressif/libpng
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBPNG} == True
      version: ^1.6.58
    - name: espressif/lz4
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LZ4} == True && $CONFIG{LV_USE_LZ4_INTERNAL} == False
      version: ^1.10.0
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 9.6.0
direct_dependencies:
- espressif/cjson
- espressif/esp_hosted
- espressif/esp_websocket_client
- espressif/led_strip
- espressif/mdns
- idf
- lvgl/lvgl
manifest_hash: 34b500c289c2f4aa38df61153aed1c25a37e4e2a6b2a49e54ed6ea9790e8b199
target: esp32p4
version: 3.0.0
