    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.7.19~2
  espressif/esp_hosted:
    component_hash: c88052665d8df3c7185cb5e34327d77674599006bbbbe4bfdb43c44f9a2a73a3
    dependencies:
    - name: idf
      require: private
      version: '>=5.5'
    source:
      registry_url: https://components.espressif.com/
      type: service
    targets:
    - esp32
    - esp32c2
    - esp32s2
    - esp32s3
    - esp32c3
    - esp32c5
