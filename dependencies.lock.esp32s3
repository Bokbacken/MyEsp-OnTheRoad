dependencies:
  espressif/cjson:
    component_hash: e788323270d90738662d66fffa910bfe1fba019bba087f01557e70c40485b469
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.7.19~2
  espressif/led_strip:
    component_hash: 027f68f2b57b0dca1d68dff6cc1139d9093825aa808c2bc3ca42bb2ce530fce9
    dependencies:
    - name: idf
      require: private
      version: '>=5.2'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 3.1.1
  espressif/mdns:
    component_hash: ef0766474b37459f6ad22461e453a8713e780e831a7c993b16919d817988dff6
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.14.1
  idf:
    source:
      type: idf
    version: 6.1.0
  lvgl/lvgl:
    component_hash: d5e723db3a3feca71e34e333a6598b7624e3822577d374e1d44f0e18374952e1
    dependencies:
    - name: espressif/freetype
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_FREETYPE} == True
      version: ^2.14.3
    - name: espressif/libjpeg-turbo
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBJPEG_TURBO} == True
      version: ^3.1.1
    - name: espressif/libpng
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBPNG} == True
      version: ^1.6.58
    - name: espressif/lz4
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LZ4} == True && $CONFIG{LV_USE_LZ4_INTERNAL} == False
      version: ^1.10.0
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 9.6.0
