menu "OnTheRoad hardware profile"

    choice OTR_HW_PROFILE
        prompt "Board profile"
        default OTR_HW_PROFILE_ES3C35P
        help
            Selects the board profile used by the application layer. The default is the current
            working board; other profiles are placeholders until ported.

        config OTR_HW_PROFILE_ES3C35P
            bool "ES3C35P (ESP32-S3, 320x480, current board)"
        config OTR_HW_PROFILE_P4_43
            bool "P4_43 (Waveshare ESP32-P4 4.3\", 480x800, placeholder / unverified)"
    endchoice

endmenu
