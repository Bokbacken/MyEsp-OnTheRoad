@meta
id: s2_demo
world: 96
map_id: 96

@about
title.sv: Verkstadens provbana
title.en: Workshop training circuit
desc.sv: Prova spak, tidsgrind, is, fyra pilriktningar och sex nyckelfärger. Par: 56 steg.
desc.en: Try a lever, timed gate, ice, four belt directions and six key colors. Par: 56 steps.
author: MyEsp-OnTheRoad

@rules
lives: infinite
par: 56

@legend
! = lever 1
I = gate 1
: = plate 2
] = gate 2
i = ice
{ = belt up
> = belt right
v = belt down
< = belt left
q = key red
H = door red
g = key green
J = door green
t = key blue
L = door blue
y = key yellow
N = door yellow
s = key purple
O = door purple
e = key cyan
V = door cyan

@timedgate 2: 36

@map
#####################
