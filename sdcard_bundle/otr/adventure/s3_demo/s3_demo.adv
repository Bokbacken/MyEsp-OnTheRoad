@meta
id: s3_demo
world: 97
map_id: 97

@about
title.sv: Isstationens sex salar
title.en: Six halls of the ice station
desc.sv: En stor provbana: skridskor, tre faror, skyddsdräkt, sex färglådor och en OCH-port.
desc.en: A large training gallery: skates, three hazards, a suit, six colored boxes and an AND gate.
author: MyEsp-OnTheRoad

@rules
start_energy: 32
energy_cap: 32
lives: infinite
suit_base_steps: 8
suit_per_extra_max: 0

