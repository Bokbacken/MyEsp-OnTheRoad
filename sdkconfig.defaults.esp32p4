# Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3 (ESP32-P4NRW32, chip rev v3.x): 32 MB flash,
# 32 MB PSRAM, console on the USB-UART bridge (UART0). Wi-Fi via ESP32-C6 (ESP-Hosted, SDIO).
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32p4.csv"
CONFIG_SPIRAM_SPEED_200M=y
# Keep the DPI frame DMA restarting while OTA/FFat operations disable the flash cache.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
CONFIG_OTR_SD_IO_DIAGNOSTICS=y
# The P4 bootloader starts at 0x2000; with the partition table at 0x8000 it must stay below 24 KB.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# --- Supernova UltraStar video test (P4 only) ---
CONFIG_ESP_PLAYER_ENABLE_AUDIO=y
CONFIG_ESP_PLAYER_ENABLE_VIDEO=y
CONFIG_ESP_PLAYER_ENABLE_FILE_IO=y
CONFIG_MP4_EXTRACTOR_SUPPORT=y
CONFIG_VIDEO_DECODER_SW_H264_SUPPORT=y
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
# The MP4 audio track is ignored; the matching MP3 file is the only audio source.
CONFIG_AUDIO_DECODER_AAC_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=n

# --- Wi-Fi through the ESP32-C6 co-processor (ESP-Hosted 3.x, SDIO, board default pins) ---
CONFIG_ESP_HOSTED=y
# Must equal the SD card clock: both slots share the P4 SDMMC host divider (main/board_sd.cpp).
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
